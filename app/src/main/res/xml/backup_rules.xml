<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: the same single file as data_extraction_rules.xml, and only with
     client-side encryption (honoured from API 28; on 26 and 27 the flag is ignored and the
     file is backed up anyway, accepted). The path is DataStoreFiles.USER_PREFERENCES. -->
<full-backup-content>
    <include domain="file" path="datastore/user_prefs.json" requireFlags="clientSideEncryption" />
</full-backup-content>
